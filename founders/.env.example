# Option 1: Google Apps Script Web App (Recommended - No Cloud Console Needed)
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Option 2: Google Sheets API Service Account (Alternative)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FOUNDERS_SPREADSHEET_ID=your_founders_spreadsheet_id_here
