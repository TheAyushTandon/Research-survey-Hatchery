  {
    "id": "sec_b_h2",
    "title": "Section B — Hypothesis 2",
    "description": "H2: The funders who adopt lean methodologies utilize government support and backing more efficiently than those funders who use traditional methods.",
    "questions": [
      {
        "id": "founders_h2_q1",
        "number": "Q1",
        "text": "Founders who use Lean methods are better at making the most of government grants and money without wasting it.",
        "type": "likert_4",
        "options": [
          "A) Strongly Disagree",
          "B) Disagree",
          "C) Agree",
          "D) Strongly Agree"
        ],
        "hasOther": false,
        "required": true
      },
      {
        "id": "founders_h2_q2",
        "number": "Q2",
        "text": "Traditional planners often waste or misuse government support because their spending plans are too strict and rigid.",
        "type": "likert_4",
        "options": [
          "A) Strongly Disagree",
          "B) Disagree",
          "C) Agree",
          "D) Strongly Agree"
        ],
        "hasOther": false,
        "required": true
      },
      {
        "id": "founders_h2_q3",
        "number": "Q3",
        "text": "Lean founders use government-backed perks (like tax breaks or funds) for product testing much faster than traditional founders.",
        "type": "likert_4",
        "options": [
          "A) Much Slower",
